# Orbis — configuration template.
# `./setup.sh` creates a real .env from this file and fills in the database
# passwords for you. The only value you must supply yourself is the Hugging
# Face token. Never commit the generated .env.

# --- Generative model provider ----------------------------------------------
# Groq is the default: the free tier is generous and noticeably faster than the
# Hugging Face router. Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Hugging Face is supported as an alternative. Set LLM_PROVIDER explicitly to
# override the automatic choice (groq when GROQ_API_KEY is set).
# LLM_PROVIDER=groq
# Create a token at https://huggingface.co/settings/tokens with the
# "Make calls to Inference Providers" permission.
HUGGINGFACE_API_KEY=hf_your_token_here

# --- MySQL: administrative account, only used by setup ----------------------
# Leave commented out. Setup normally reaches MySQL by itself (socket auth, or
# the Debian/Ubuntu maintenance account). Set these only if that fails and root
# is not usable on your machine — any account that can create databases and
# users will do. Setup never stores them; the application does not read them.
# MYSQL_ADMIN_USER=
# MYSQL_ADMIN_PASSWORD=

# --- MySQL: read-only HR data (used by the NL->SQL engine) ------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=orbis_user
MYSQL_PASSWORD=__GENERATED__
MYSQL_DATABASE=orbis_hr

# --- MySQL: read-write app state (users, chats, audit) ----------------------
MYSQL_APP_USER=orbis_app
MYSQL_APP_PASSWORD=__GENERATED__
MYSQL_APP_DATABASE=orbis_app

# --- MySQL: read-write HR admin (the admin "Employees" tab only) ------------
MYSQL_HR_ADMIN_USER=orbis_hr_admin
MYSQL_HR_ADMIN_PASSWORD=__GENERATED__

# --- Models -----------------------------------------------------------------
# Changing the embedding model changes the vector size; re-index afterwards
# with: python -m rag_engine.maintenance
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5

# Groq model ids (used when LLM_PROVIDER=groq)
GROQ_ANSWER_MODEL=openai/gpt-oss-120b
GROQ_SQL_MODEL=openai/gpt-oss-120b
GROQ_ROUTER_MODEL=llama-3.1-8b-instant
GROQ_VERIFIER_MODEL=llama-3.3-70b-versatile

# Hugging Face model ids (used when LLM_PROVIDER=huggingface)
HF_ANSWER_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_SQL_MODEL=meta-llama/Llama-3.1-8B-Instruct

# --- Employer identity ------------------------------------------------------
# Company email addresses are minted from this domain and are the login identity.
COMPANY_NAME=Orbis
COMPANY_EMAIL_DOMAIN=orbis.com

# --- Onboarding email -------------------------------------------------------
# 'console' prints invitations to the backend terminal — no mail setup needed,
# and no message can reach a real inbox. Use 'smtp' plus the SMTP_* values to
# send for real.
EMAIL_BACKEND=console
APP_BASE_URL=http://localhost:5173
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# --- Sessions ---------------------------------------------------------------
SESSION_TTL_DAYS=7
INVITE_TTL_DAYS=7

# --- Frontend origins allowed to call the API -------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
